# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Your Telegram User ID or Group ID for receiving orders and support requests
# (Get your ID by messaging @userinfobot)
ADMIN_CHAT_ID=your_telegram_chat_id_here

# Store Information
STORE_NAME="স্মার্ট গ্যাজেট ও লাইফস্টাইল শপ"
STORE_PHONE="+8801700000000"
STORE_EMAIL="support@myshop.com"
CURRENCY="৳"

# Delivery Charges
DELIVERY_FEE_INSIDE_DHAKA=80
DELIVERY_FEE_OUTSIDE_DHAKA=150

# Payment Accounts (For manual bKash/Nagad)
BKASH_NUMBER="01700000000 (Personal/Merchant)"
NAGAD_NUMBER="01700000000 (Personal)"

# Google Sheets CSV URL for remote catalog sync (optional, can be left blank)
# To use: publish your Google Sheet as CSV via File > Share > Publish to web > CSV
GOOGLE_SHEETS_CSV_URL=""
